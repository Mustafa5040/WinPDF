<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinPDF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local1="using:WinPDF.ViewModels"
    xmlns:local="using:WinPDF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Title Bar -->
            <RowDefinition Height="*" />
            <!-- TabView -->
        </Grid.RowDefinitions>
        <TitleBar x:Name="DefaultTitleBar" Title="WinPDF" Subtitle="Preview" Grid.Row="0">
            <TitleBar.IconSource>
                <SymbolIconSource Symbol="PhoneBook"/>
            </TitleBar.IconSource>
        </TitleBar>
        <TabView x:Name="TabViewElement" 
                 Loaded="TabView_Loaded" 
                 AddTabButtonClick="TabViewElement_AddTabButtonClick" 
                 TabCloseRequested="TabViewElement_TabCloseRequested" 
                 TabItemsSource="{Binding TabsCollection}" 
                 Grid.Row="1" 
                 VerticalAlignment="Stretch" 
                 HorizontalAlignment="Stretch">
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="local1:TabViewModel">
                    <TabViewItem Header="{Binding Title}">
                        <Frame Content="{Binding ContFrame}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>
    </Grid>
</Window>