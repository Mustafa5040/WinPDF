<Page
    x:Class="WinPDF.Views.PDFPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinPDF.Views"
    xmlns:local1="using:WinPDF.ViewModels"
    xmlns:canvas="using:ABI.Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource LayerOnMicaBaseAltFillColorTransparentBrush}">
    <Grid AllowDrop="True" Drop="Grid_Drop" HorizontalAlignment="Stretch" DragOver="Grid_DragOver" VerticalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- CommandBar (fixed height) -->
            <RowDefinition Height="*"/>
            <!-- Main content (full height) -->
        </Grid.RowDefinitions>
        <!-- Top Command Bar -->
        <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Center" Grid.Row="0">
            <AppBarToggleButton x:Name="BolumlerAppBarButton" Icon="Preview" Label="Bölümler" Click="BolumlerAppBarButtonClicked" IsEnabled="False"/>
            <AppBarToggleButton Icon="Find" Label="Ara"/>
            <AppBarToggleButton Icon="Edit" Label="Düzenle"/>
            <AppBarButton Icon="Share" Label="Paylaş"/>
            <AppBarButton Icon="Help" Label="Öznitelikler"/>
        </CommandBar>
        <!-- Main Content Area -->
        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- TreeView panel (fixed or resizable) -->
                <ColumnDefinition Width="*"/>
                <!-- Main content (expandable) -->
            </Grid.ColumnDefinitions>
            <!-- Left Panel (TreeView) -->
            <Grid x:Name="TreeViewGrid"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  Grid.Column="0"
                  MinWidth="200" MaxWidth="400" Width="300"
                  VerticalAlignment="Stretch"
                  Visibility="Collapsed"
                  CornerRadius="10">
                <!-- Ensures full height -->
                <TreeView x:Name="mddtreeview"
                          VerticalAlignment="Stretch">
                    <!-- Allows it to fill parent Grid -->
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="local1:PDFViewModel">
                            <TreeViewItem Content="{x:Bind name}" Padding="7"/>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
            <!-- Right Content Area -->
            <Grid Grid.Column="1"
                  CornerRadius="10"
                  AllowDrop="True"
                  Drop="StackPanel_Drop">
                <!-- Full height -->
                <ScrollView 
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Visible"
                              VerticalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Visible"
                              MinZoomFactor="0.1"
                              MaxZoomFactor="5"
                              ZoomMode="Enabled"
                              IsTabStop="True"
                              ManipulationMode="All">
                    <ItemsRepeater x:Name="mddItemRepeater" HorizontalAlignment="Center">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="20"
                                      CornerRadius="25"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Width="Auto"
                                      Height="Auto">
                                    <Image Source="{Binding}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollView>
            </Grid>
        </Grid>
    </Grid>
</Page>
